# Database connection
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/ai_tutor

# JWT Secret for local authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_for_local_development

# Seeded Dev Account (Local Development Only)
DEV_USER_EMAIL=dev@example.com
DEV_USER_PASSWORD=devpassword123
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=

# LLM Providers (Groq, Ollama, Timeout)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=
LLM_REQUEST_TIMEOUT_S=60

# LiveKit Voice Transport
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

